name: barbergo_app
description: A Flutter app that connects barbers and barbershops for freelance, CLT and commission opportunities.

environment:
  sdk: ^3.8.0

dependencies:
  flutter:
    sdk: flutter
  firebase_core:
  cloud_firestore:
  firebase_auth:
  firebase_storage:
  flutter_riverpod: ^3.0.3
  riverpod_annotation: ^3.0.3
  go_router:
  freezed_annotation: ^3.1.0
  json_annotation: ^4.9.0
  cached_network_image:
  intl:
  flutter_card_swiper: ^7.0.2
  dio: ^5.7.0
  google_generative_ai: ^0.4.7
  openai_dart: ^0.5.5
  anthropic_sdk_dart: ^0.2.3
  flutter_dotenv: ^6.0.0
  flutter_markdown: ^0.7.7+1
  uuid: ^4.5.1
  firebase_analytics: ^12.0.3
  firebase_crashlytics: ^5.0.3
  firebase_remote_config: ^6.1.0
  rxdart: ^0.28.0
  firebase_messaging: ^16.0.3
  dart_mappable: ^4.6.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  build_runner: ^2.7.1
  freezed: 3.2.0  # DOWNGRADE: versão 3.2.3 tem bug com mixin
  json_serializable: ^6.8.0
  riverpod_generator: ^3.0.3
  analyzer: 7.5.9  # TESTE 10: versão 7.5.x compila sem erros Freezed (máximo compatível com dart_mappable)
  flutter_lints:
  integration_test:
    sdk: flutter
  mockito: ^5.4.4
  firebase_auth_mocks: ^0.15.1
  dart_mappable_builder: ^4.6.0

flutter:
  assets:
    - .env
