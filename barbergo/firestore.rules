rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função helper: Verifica se o usuário está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // === PROFILES & Subcoleções ===
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      // Subcoleção: Interactions (Privado)
      match /interactions/{interactionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Subcoleção: AI Chats (Privado)
      match /ai_chats/{personaKey}/messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Subcoleção: Notifications (Privado - Implementada nesta Sprint)
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Subcoleção: Portfolio (Público para leitura, escrita apenas pelo dono)
      match /portfolio/{itemId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Subcoleção: Preferences (Privado - Filter preferences)
      match /preferences/{preferencesType} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // === VACANCIES ===
    match /vacancies/{vacancyId} {
      // Leitura: Se ativa OU se for o dono.
      allow read: if isSignedIn() && (
        resource.data.isActive == true || 
        request.auth.uid == resource.data.barbershopId
      );
      allow create: if isSignedIn() && request.resource.data.barbershopId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.barbershopId;
    }

    // === APPLICATIONS ===
    match /applications/{applicationId} {
      // Leitura: Pelo Barbeiro que aplicou OU pela Barbearia que recebeu.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.barberId ||
        request.auth.uid == resource.data.barbershopId
      );
      allow create: if isSignedIn() && request.resource.data.barberId == request.auth.uid;
      // Atualização (Status): Apenas a barbearia dona da vaga.
      allow update: if isSignedIn() && request.auth.uid == resource.data.barbershopId;
    }
    
    // === VACANCY MATCHES (Sistema Tinder de Vagas) ===
    match /vacancy_matches/{matchId} {
      // Leitura de documento específico: Barbeiro ou Barbearia do match
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.barberId ||
        request.auth.uid == resource.data.barbershopId
      );
      
      // Leitura de lista (query): Permite se autenticado
      // A segurança real virá da query que filtra por vacancyId ou barberId
      allow list: if isSignedIn();
      
      // Criação: Apenas quando há match mútuo (implementar via Cloud Function idealmente)
      // Por ora, permite criar se for um dos participantes
      allow create: if isSignedIn() && (
        request.resource.data.barberId == request.auth.uid ||
        request.resource.data.barbershopId == request.auth.uid
      );
      // Atualização: Status, mensagens, etc - ambos podem atualizar
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.barberId ||
        request.auth.uid == resource.data.barbershopId
      );
      allow delete: if false; // Não permite deletar matches
      
      // Mensagens do Match (subcoleção)
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/vacancy_matches/$(matchId)).data.barberId ||
          request.auth.uid in get(/databases/$(database)/documents/vacancy_matches/$(matchId)).data.barbershopId
        );
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if false;
      }
    }
    
    // === CHAT ROOMS (NOVO - Sprint 21) ===
    match /chat_rooms/{roomId} {
      // Leitura/Escrita apenas se o usuário estiver na lista de participantes
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      // Mensagens Diretas
      match /messages/{messageId} {
         // Leitura: Herda as permissões da sala (usando get() para acessar o documento pai)
         allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds;
         // Criação: Apenas se for o remetente E estiver na sala
         allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid &&
                        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds;
      }
    }
    
    // === SWIPES (Match System) ===
    match /swipes/{swipeId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // === MATCHES ===
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if false; // Apenas Cloud Function
      allow update: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow delete: if false;
    }
    
    // === CHATS (Match Chats) ===
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if false;
      }
    }
    
    // === PORTFOLIO (Collection-level) ===
    match /portfolio/{itemId} {
      function getOwnerId() {
        return resource.data.userId;
      }
      
      allow read: if true; // Público
      allow write: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }
    
    // === BLOCKED USERS (Subcollection in profiles) ===
    // Já implementado em profiles/{userId}/blocked/{blockedUserId}
    
    // === REPORTS ===
    match /reports/{reportId} {
      allow read: if false; // Apenas admin
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if false; // Apenas admin
    }
    
    // === STRIPE CUSTOMERS & CHECKOUT SESSIONS ===
    match /customers/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Checkout Sessions (Stripe Integration)
      match /checkout_sessions/{sessionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Payment Methods (Stripe Integration)  
      match /payment_methods/{methodId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    // === BOOKINGS (Sistema de Agendamento - Phase 10) ===
    match /bookings/{bookingId} {
      // Leitura: Apenas barbeiro ou cliente do agendamento
      allow read: if isSignedIn() && (
        resource.data.barberId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      
      // Criação: Usuário autenticado pode criar (será cliente)
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      
      // Atualização: Barbeiro ou cliente podem atualizar
      // Barbeiro: Confirmar, completar
      // Cliente: Cancelar (se canBeCancelled)
      allow update: if isSignedIn() && (
        resource.data.barberId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      
      // Deleção: Apenas admin/debugging
      allow delete: if false;
    }
  }
}
